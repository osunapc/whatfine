NODE_ENV=
BACKEND_URL=http://localhost
FRONTEND_URL=http://localhost:3000
PROXY_PORT=8080
PORT=8080

# Prisma DATABASE_URL (for SQLite, relative to the prisma schema file or an absolute path)
# Example for SQLite file in the 'prisma' directory, assuming .env is in 'backend':
# DATABASE_URL="file:./prisma/dev.db"
# Example for SQLite file in the 'backend' directory (root of backend project):
DATABASE_URL="file:./dev.db"

# Old Sequelize DB variables (no longer used by Prisma with DATABASE_URL)
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_USER=root
# DB_PASS=
# DB_NAME=whaticket

JWT_SECRET=
JWT_REFRESH_SECRET=
